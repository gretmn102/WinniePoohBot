    "@types/node-telegram-bot-api": "^0.64.7",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.57.1",
    "rollup": "~4.14.1",
    "shx": "^0.3.4",
    "typescript": "^5.6.3",
    "vite": "~5.2.8",
    "vitest": "~1.4.0"
  }
