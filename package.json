  "main": "index.js",
  "scripts": {
    "build": "tsc --project tsconfig.build.json --outDir dist",
    "start": "cd dist && node index.js",
    "dev": "npm run build && npm run start",
    "test": "vitest",
    "deploy:clear": "shx rm -rf dist/*",
